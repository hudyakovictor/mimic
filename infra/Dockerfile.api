FROM python:3.12-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/services/api:/app/services/worker:/app

# System deps: ffmpeg, libpq, build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libpq5 \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install uv
RUN pip install --upgrade pip
RUN pip install uv

# Copy project files
COPY pyproject.toml README.md ./
COPY packages ./packages
COPY services/api ./services/api
COPY services/worker ./services/worker
COPY scripts ./scripts

# API only needs URL/YouTube ingestion extras; ML dependencies live in the worker.
RUN uv pip install --system --no-cache -e ".[youtube]"

EXPOSE 8080
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
