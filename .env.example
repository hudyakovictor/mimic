# MimicGuard — environment variables
# Copy to .env and adjust for your environment.

# --- General ---
ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=mimicguard

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
API_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_RPS=10

# --- Database ---
DATABASE_URL=postgresql+asyncpg://mimicguard:mimicguard@localhost:5432/mimicguard
# For SQLite fallback in dev without postgres:
# DATABASE_URL=sqlite+aiosqlite:///./mimicguard.db

# --- Redis (broker + cache) ---
REDIS_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6379/1

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=mimicguard
S3_SECRET_KEY=change-me-now
S3_BUCKET_VIDEOS=mimicguard-videos
S3_BUCKET_DERIVED=mimicguard-derived
S3_BUCKET_CLIPS=mimicguard-clips
S3_BUCKET_MODELS=mimicguard-models
S3_BUCKET_AUDIT=mimicguard-audit
S3_PRESIGNED_URL_TTL=900

# --- Security ---
JWT_SECRET=dev-secret-change-me-in-production-use-vault
JWT_ALG=HS256
JWT_AUDIENCE=mimicguard-api
JWT_ISSUER=mimicguard
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=86400

# --- Upload limits ---
MAX_UPLOAD_BYTES=1073741824          # 1 GB
MAX_VIDEO_DURATION_SECONDS=1800     # 30 min

# --- MediaPipe ---
MEDIAPIPE_MODEL_PATH=                # leave empty to auto-download
MEDIAPIPE_MIN_CONFIDENCE=0.5

# --- ASR ---
ASR_MODEL_SIZE=small                  # tiny|base|small|medium|large-v3
ASR_DEVICE=auto                       # auto|cpu|cuda
ASR_COMPUTE_TYPE=int8

# --- Quality thresholds ---
QUALITY_MIN_FRAMES=15
QUALITY_MIN_MEAN_CONFIDENCE=0.72
QUALITY_MAX_GAP_MS=180
QUALITY_MAX_ABS_YAW=45
QUALITY_MIN_SCORE=0.55

# --- Decision thresholds ---
DECISION_RISK_CONSISTENT_MAX=0.35
DECISION_RISK_SUSPICIOUS_MIN=0.65
PHRASE_BASELINE_MIN_SAMPLES=3
PHRASE_BASELINE_MATURE_SAMPLES=10
PHRASE_TEMPLATE_MAX_SAMPLES=50

# --- Outbox relay ---
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=200
OUTBOX_MAX_ATTEMPTS=10

# --- Worker ---
WORKER_TIME_LIMIT_DEFAULT=300000
WORKER_RETRY_DEFAULT=3

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PATH=/metrics

# --- Default admin (seeded on first run) ---
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=change-me-now-12chars
DEFAULT_TENANT_SLUG=default
